<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Macast.Core</AssemblyName>
    <RootNamespace>Macast.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- One wildcard for every asset (XML, csv, version.txt and icon.ico). The
         previous split item silently lost icon.ico in RID-specific publish. -->
    <Content Include="Assets/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
